{
  "name": "ghee-client",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "lint": "eslint src functions scripts",
    "check": "npm run lint && npm run typecheck && npm run check:xlsx && npm run check:reference && npm run check:order && npm run check:barcode",
    "check:xlsx": "node scripts/check-xlsx.mjs",
    "check:reference": "node scripts/check-reference.mjs",
    "check:order": "node scripts/check-order.mjs",
    "check:barcode": "node scripts/check-barcode.mjs",
    "deploy": "npm run build && wrangler pages deploy --branch=main",
    "typecheck": "node scripts/check-syntax.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.31.0",
    "eslint": "^9.31.0",
    "vite": "^7.0.0",
    "wrangler": "^4.147.0"
  },
  "dependencies": {
    "three": "^0.186.1"
  }
}
